# Копирај го овој фајл во .env и пополни ги вредностите пред `docker compose up`

# --- База на податоци ---
DB_NAME=focuslab
DB_USER=focuslab
DB_PASSWORD=promeni-me

# --- JWT ---
# Генерирај силна случајна вредност (на пр. `openssl rand -base64 48`)
JWT_SECRET=promeni-ja-ovaa-tajna-vo-produkcija-focuslab-2026-minimum-256-bit
JWT_EXPIRATION_MS=86400000

# --- Microsoft 365 / Outlook SMTP ---
# Користи ја твојата M365/Outlook сметка. Ако имаш вклучена MFA,
# генерирај "App Password" во Microsoft account security settings
# и стави го тука наместо обичната лозинка.
MAIL_USERNAME=your-account@yourdomain.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=focuslab@yourdomain.com

# --- Администраторска сметка (се креира автоматски при прво стартување) ---
ADMIN_EMAIL=admin@focuslab.mk
ADMIN_PASSWORD=promeni-me-silna-lozinka

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5173
